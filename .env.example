# =====================================================================
# Required: secret used to sign JWTs. Generate with: openssl rand -base64 48
# =====================================================================
IRIS_JWT_SECRET=

# =====================================================================
# Bootstrap admin: created on first boot if no users exist. Once you've
# logged in once and created your real admin account through the UI you
# can comment these out — they're a no-op when the users table isn't empty.
# =====================================================================
IRIS_AUTH__BOOTSTRAP_ADMIN__EMAIL=admin@iris.local
IRIS_AUTH__BOOTSTRAP_ADMIN__PASSWORD=change-me-immediately

# =====================================================================
# Public URL — used as the JWT issuer claim. Should match what Cloudflare
# (or whatever proxy you use) exposes externally so refresh-tokens issued
# behind one front-door verify correctly behind another.
# =====================================================================
IRIS_SERVER__PUBLIC_URL=http://localhost:8080

# =====================================================================
# Local-port options (irrelevant when fronting via Cloudflare tunnel).
# =====================================================================
IRIS_BIND_PORT=8080
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# =====================================================================
# Cloudflare named tunnel — gives Iris a stable public URL on your own
# domain without opening any inbound ports. Workflow:
#   1. https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
#   2. Copy the tunnel TOKEN here
#   3. In the tunnel's "Public Hostname" tab, point your hostname at
#      "http://iris:8080" (the compose service name resolves on the
#      cloudflared <-> iris network).
#   4. docker compose --profile cloudflared up -d
# =====================================================================
CLOUDFLARE_TUNNEL_TOKEN=

# =====================================================================
# Logging filter (env-filter syntax).
# =====================================================================
RUST_LOG=info,iris=debug,tower_http=info

# =====================================================================
# Tracker credentials. One block per provider declared in providers.toml,
# referenced from there via username_env / password_env.
# =====================================================================
TORR9_USERNAME=
TORR9_PASSWORD=
