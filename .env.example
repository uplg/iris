# Required: secret used to sign JWTs. Generate with: openssl rand -base64 48
IRIS_JWT_SECRET=

# Optional: bind ports
IRIS_BIND_PORT=8080
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Optional: domain for Caddy (only used if you run with profile "proxy")
IRIS_DOMAIN=localhost

# Optional: log filter
RUST_LOG=info,iris=debug,tower_http=info

# Tracker credentials (one block per provider declared in providers.toml).
# Referenced from providers.toml via username_env / password_env.
TORR9_USERNAME=
TORR9_PASSWORD=

