# One entry per tracker provider. `kind` selects the impl in iris-providers.
# Secrets should NEVER be inlined here — use `<key>_env` to point at an env var.

# c411 (Communauté 411) — Torznab search + curated /api/homepage featured.
[[providers]]
id = "c411"
kind = "c411"
enabled = true
base_url = "https://c411.org"
api_key_env = "C411_API_KEY"
# optional Torznab tunings:
# api_path = "/api"
# movie_categories = "2000,2030,2040,2045,2050"
# tv_categories    = "5000,5030,5040,5045,5070"

# TheOldSchool — UNIT3D tracker, JSON:API native (UNIT3D doesn't ship
# Torznab; use `kind = "unit3d"` for any UNIT3D-derived indexer:
# BLU, Aither, AvistaZ, etc.).
[[providers]]
id = "tos"
kind = "unit3d"
enabled = true
base_url = "https://theoldschool.cc"
api_key_env = "TOS_API_KEY"

# SeedPool — another UNIT3D tracker; identical wiring, just a
# different base_url + api_key_env. Ships English releases
# without explicit language markers, so the search/scheduler
# language detector falls through to `default_language` for
# anything it can't classify — gives anglophone users an EN
# badge in the UI instead of a useless "unknown" label.
[[providers]]
id = "seedpool"
kind = "unit3d"
enabled = true
base_url = "https://seedpool.org"
api_key_env = "SEEDPOOL_API_KEY"
# Mainline UNIT3D numbers movies 1 and TV 2 (`movie_category_id` /
# `tv_category_id` override them). A tracker with more video categories
# lists them all, and only those are searched (books, games left out):
# movie_category_ids = [1, 7, 13]
# tv_category_ids = [2, 6, 14, 15]
default_language = "english"

# HD-Torrents — English private HD tracker with no API at all: the
# provider logs in with your site credentials (cookie session) and
# scrapes the torrents.php HTML. Like Seedpool, releases ship without
# language markers → default_language gives them the EN badge.
[[providers]]
id = "hdt"
kind = "hdtorrents"
enabled = true
base_url = "https://hd-torrents.org"
username_env = "HDT_USERNAME"
password_env = "HDT_PASSWORD"
default_language = "english"

# Generic Torznab indexer (Jackett-fed, Prowlarr-fed, NewzNab clones).
# UNIT3D-based trackers should use `kind = "unit3d"` above instead.
# [[providers]]
# id = "myindexer"
# kind = "torznab"
# enabled = true
# base_url = "https://indexer.example"
# api_key_env = "MYINDEXER_API_KEY"
