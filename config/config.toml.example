providers_file = "./config/providers.toml"

[server]
bind = "0.0.0.0:8080"
public_url = "http://localhost:8080"
# web_dist = "/srv/iris/web"  # path to React build output (set in production)

[storage]
data_dir = "./data"
download_dir = "./data/downloads"
max_storage_gb = 500
cleanup_threshold_pct = 90
cleanup_target_pct = 75
# BitTorrent listen port (TCP + UDP). Pin so you can forward it in your
# router/firewall.
torrent_port = 45100

# Discovery "rolling window". The freshness scheduler polls each provider's
# latest-releases feed (torr9 RSS, UNIT3D `created_at`, Torznab query-less),
# one provider × kind slice per tick so tracker load stays spread out, then
# correlates each fresh release to TMDB/AniList and keeps a sliding window of
# recent, guaranteed-grabbable titles for the "For You" shelves. Needs [tmdb]
# configured (poster/genre enrichment) + at least one provider. All values are
# optional — the defaults shown below are used when the section is absent.
[discovery]
poll_window_weeks = 8        # how far back (upload time) a release may be and still enter the window
retain_weeks = 4             # how long a windowed release is kept before the GC slides it out
slice_interval_minutes = 10  # minutes between slices (full cycle ≈ this × providers × 2)
# Max age (years) of a MOVIE's *content* allowed in the discovery shelves. A
# 1972 film freshly re-uploaded is a fresh upload but not a fresh release, so
# it's kept out of discovery (still reachable via recommendations / search).
# TV is exempt (a long-running series airing a new episode is legit). Raise it
# to embrace older catalogue, lower it for a stricter "recent only" feel.
max_content_age_years = 10

# Content-first recommendation engine (see RECOSYS.md). All optional — the
# defaults below apply when the section is absent.
[reco]
enabled = true
# model2vec model id (HF repo or local path). potion-retrieval-32M won the rig
# sweep; swap to minishlab/potion-base-8M for a smaller (~8 MB) table.
model = "minishlab/potion-retrieval-32M"
centroids = 3          # taste centroids per user (weighted k-means)
embed_batch = 512      # items embedded per background ingest slice
# The catalogue records ONE best release per title (smallest-sane size, seeders
# as a garde-fou) — which can land on a 4K REMUX (75 GB) when smaller encodes
# are low-seeded. The reco / mood shelves skip proposing a release above these
# per-kind ceilings (GiB); the title still surfaces via discover and re-searches
# a saner release at grab. Set 0 to disable a cap. Movies are capped tighter;
# TV is looser because a legit season pack is large.
max_movie_gib = 40
max_tv_gib = 100

[auth]
# Override every value below with IRIS_AUTH__<KEY> environment variables in
# production. The JWT secret in particular MUST come from the environment.
jwt_secret = "change-me-in-production"
access_ttl_secs = 3600
refresh_ttl_secs = 604800
# Refresh-token lifetime for paired devices (Android TV). Sliding: every
# refresh re-issues the full window, so a TV in regular use never logs out;
# only one left off longer than this whole window needs re-pairing. Default
# 1 year. Bump higher (e.g. 1095 days) for TVs that sit idle for months.
device_refresh_ttl_secs = 31536000
invitation_ttl_secs = 604800

# The bootstrap admin user — created on first boot if the users table is
# empty. Prefer setting these via env (IRIS_AUTH__BOOTSTRAP_ADMIN__EMAIL /
# IRIS_AUTH__BOOTSTRAP_ADMIN__PASSWORD) so credentials don't live in a file
# you might commit. The block below is left commented out as a reminder.
#
# [auth.bootstrap_admin]
# email = "admin@iris.local"
# password = "change-me-immediately"

[transcode]
# Server-side "catch-up" transcode. Iris only re-encodes when a client tells
# it (via Iris-Caps `av1-sw`) that it can ONLY software-decode the source
# codec AND the content is heavy (10-bit) — e.g. a 1080p 10-bit AV1 file on a
# TV box with no AV1 silicon (Amlogic S905X2 & co), which stutters in
# software. Everything else is stream-copied (zero re-encode). The output is
# capped at 1080p and cached on disk like any other remux.
#
# The transcode STREAMS into HLS as it encodes (the player follows ~live), so
# the encoder MUST stay ahead of real-time playback or it stalls.
#
# codec: "h264" (default — `libx264` encodes several times faster than x265, so
#   a CPU-only server keeps up; 8-bit, ~2x bigger on disk) or "hevc"
#   (hardware-decoded by most TV chips incl. 10-bit, ~2x smaller, but only
#   viable if your server can sustain real-time x265).
codec = "h264"
# preset: libx264/libx265 -preset. "veryfast" gives a comfortable real-time
# margin for H.264 on an older Xeon; slower presets = smaller files but risk
# stalling. Drop to "ultrafast" if even veryfast can't keep up.
preset = "veryfast"
# crf: 0..=51, lower = better quality / larger files. 26 is a good size/quality
# balance for the fallback path.
crf = 26
# ten_bit: keep a 10-bit pipeline (HEVC only). false (default) encodes 8-bit —
# faster, smaller, and invisible for SDR sources. true preserves the source's
# 10-bit precision at some encode-speed + size cost.
ten_bit = false
