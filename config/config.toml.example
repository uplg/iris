providers_file = "./config/providers.toml"

[server]
bind = "0.0.0.0:8080"
public_url = "http://localhost:8080"
# web_dist = "/srv/iris/web"  # path to the web build (web/build; set in production)

[storage]
data_dir = "./data"
download_dir = "./data/downloads"
max_storage_gb = 500
cleanup_threshold_pct = 90
cleanup_target_pct = 75
# Free space the disk must keep whatever the budget says (GiB, 0 = off).
min_free_gb = 10
# Files in download_dir no torrent references, untouched for this long, are
# logged by the GC; set delete_orphan_files = true to delete them.
orphan_min_age_hours = 24
delete_orphan_files = false
# BitTorrent listen port (TCP + UDP). Pin so you can forward it in your
# router/firewall.
torrent_port = 45100

# Discovery "rolling window". The freshness scheduler polls each provider's
# latest-releases feed (UNIT3D `created_at`, Torznab query-less),
# one provider × kind slice per tick so tracker load stays spread out, then
# correlates each fresh release to TMDB/AniList and keeps a sliding window of
# recent, guaranteed-grabbable titles for the "For You" shelves. Needs [tmdb]
# configured (poster/genre enrichment) + at least one provider. All values are
# optional — the defaults shown below are used when the section is absent.
#
# Alongside it, the pulse scheduler (no knobs) snapshots what the world is
# watching every 3 h — TMDB trending / digital releases / on the air / the
# curated moods, plus SIMKL's public "watched today" lists — and searches the
# same trackers for a budgeted batch of those titles (≈60 per cycle, spaced).
[discovery]
poll_window_weeks = 8        # how far back (upload time) a release may be and still enter the window
retain_weeks = 4             # how long a windowed release is kept before the GC slides it out
slice_interval_minutes = 10  # minutes between slices (full cycle ≈ this × providers × 2)
# Max age (years) of a MOVIE's *content* allowed in the discovery shelves. A
# 1972 film freshly re-uploaded is a fresh upload but not a fresh release, so
# it's kept out of discovery (still reachable via search).
# TV is exempt (a long-running series airing a new episode is legit). Raise it
# to embrace older catalogue, lower it for a stricter "recent only" feel.
max_content_age_years = 10

[auth]
# Override every value below with IRIS_AUTH__<KEY> environment variables in
# production. The JWT secret in particular MUST come from the environment.
jwt_secret = "change-me-in-production"
access_ttl_secs = 3600
refresh_ttl_secs = 604800
# Refresh-token lifetime for paired devices (Android TV). Sliding: every
# refresh re-issues the full window, so a TV in regular use never logs out;
# only one left off longer than this whole window needs re-pairing. Default
# 1 year. Bump higher (e.g. 1095 days) for TVs that sit idle for months.
device_refresh_ttl_secs = 31536000
invitation_ttl_secs = 604800

# The bootstrap admin user — created on first boot if the users table is
# empty. Prefer setting these via env (IRIS_AUTH__BOOTSTRAP_ADMIN__EMAIL /
# IRIS_AUTH__BOOTSTRAP_ADMIN__PASSWORD) so credentials don't live in a file
# you might commit. The block below is left commented out as a reminder.
#
# [auth.bootstrap_admin]
# email = "admin@iris.local"
# password = "change-me-immediately"

[transcode]
# Server-side "catch-up" transcode. Iris only re-encodes when a client tells
# it (via Iris-Caps `av1-sw`) that it can ONLY software-decode the source
# codec AND the content is heavy (10-bit) — e.g. a 1080p 10-bit AV1 file on a
# TV box with no AV1 silicon (Amlogic S905X2 & co), which stutters in
# software. Everything else is stream-copied (zero re-encode). The output is
# capped at 1080p and cached on disk like any other remux.
#
# The transcode STREAMS into HLS as it encodes (the player follows ~live), so
# the encoder MUST stay ahead of real-time playback or it stalls.
#
# codec: "h264" (default — `libx264` encodes several times faster than x265, so
#   a CPU-only server keeps up; 8-bit, ~2x bigger on disk) or "hevc"
#   (hardware-decoded by most TV chips incl. 10-bit, ~2x smaller, but only
#   viable if your server can sustain real-time x265).
codec = "h264"
# preset: libx264/libx265 -preset (default "superfast"). It keeps a
# comfortable real-time margin on an older Xeon; slower presets = smaller files
# but risk stalling. Drop to "ultrafast" if even superfast can't keep up.
preset = "superfast"
# crf: 0..=51, lower = better quality / larger files. 26 is a good size/quality
# balance for the fallback path.
crf = 26
# ten_bit: keep a 10-bit pipeline (HEVC only). false (default) encodes 8-bit —
# faster, smaller, and invisible for SDR sources. true preserves the source's
# 10-bit precision at some encode-speed + size cost.
ten_bit = false

[live_tv]
# Live TV: per-country IPTV channel lists (iptv-org playlists) played through
# the backend's signed HLS proxy — upstream streams are plain-http, CORS-less,
# and several demand a browser User-Agent, so clients never hit them directly.
# Countries are fetched lazily on first access, then kept fresh in background.
enabled = true
# Country pre-selected by clients (ISO 3166-1 alpha-2, lowercase).
default_country = "fr"
# Where playlists / the country catalogue come from ({code} = country code).
# playlist_url_template = "https://iptv-org.github.io/iptv/countries/{code}.m3u"
# countries_url = "https://iptv-org.github.io/api/countries.json"
# Every country's playlist in one file: how many channels each country has.
# country_index_url = "https://iptv-org.github.io/iptv/index.country.m3u"
# Gzipped XMLTV guides per country, for the now/next overlay. Countries
# without an entry simply show no programme info.
# [live_tv.epg_urls]
# fr = "https://xmltvfr.fr/xmltv/xmltv_tnt.xml.gz"
# Extra fallback playlists per country: entries matching a channel already in
# the iptv-org list (by tvg-id / name) merge in as additional sources the
# proxy rotates to when the primary stream dies.
# [live_tv.extra_playlists]
# fr = ["https://raw.githubusercontent.com/LeBazarDeBryan/XTVZ_/main/IPTV/TNTenDirect.m3u"]
# Re-pin a channel's French TNT number without a release (tvg-id base → n°).
# [live_tv.tnt_overrides]
# CanalPlus = 40
# Map a channel id to its XMLTV guide id when they don't match.
# [live_tv.epg_id_overrides]
# france4hd = "France4.fr"
# The household's own DVB-T tuner (tunerd). Channels it carries stream
# straight off the antenna with absolute priority; every internet source
# stays as automatic fallback. The box serves its own channel grid at
# {base_url}/channels — nothing else to configure here.
# [live_tv.tuner]
# enabled = true
# base_url = "http://100.101.102.103:8554"
# # Channel ids hydrated at boot and kept warm (instant joins with a full
# # buffer). Each id pins its whole mux (all channels on that frequency).
# # Two adapters = two warm muxes; viewers outrank warmth (a third-mux zap
# # reclaims an unwatched mux, or falls back to internet if both muxes have
# # active viewers).
# prewarm = ["m6", "rmcdecouverte"]
# dlive.sx (a DaddyLiveHD mirror): extra sources for the listed channels,
# chiefly the pay sports channels (beIN, Canal+, RMC Sport, Eurosport, DAZN)
# plus a second feed for the big TNT networks. Per channel the election goes
# tuner → dlive's first player → Vavoo → dlive's other players → iptv-org →
# the extra playlists. Every dlive failure hands over to the next source: a
# missing channel or a dead feed cools that source down, an outage run (or
# dlive.sx unreachable) opens a breaker that skips every dlive source for
# breaker_open_mins. dlive.sx bans an IP for ~10 min after ~100 page loads,
# so Iris reads the list once a day and scrapes embed pages lazily under a
# hard page_budget per page_budget_window_mins, never on a channel switch.
# [live_tv.dlive]
# enabled = false
# base_url = "https://dlive.sx"      # DaddyLive moves domains; follow it here
# players = [1, 2, 6]                # 1 premium edge, 2 signed edge, 6 5-min token; 3/4/5 flaky
# index_refresh_hours = 24
# page_budget = 20
# page_budget_window_mins = 10
# embed_cache_hours = 24
# first_byte_timeout_secs = 5        # while another source could take over
# cold_start_timeout_secs = 25       # when dlive is the channel's last option
# breaker_failures = 4
# breaker_open_mins = 15
# merge_all = true                  # every other dlive channel, as a source of a same-named listed one
# [live_tv.dlive.countries]
# fr = [469, 950, 951, 952, 953, 470, 958, 959, 955, 957, 964, 962, 645, 963, 954, 961, 965,
#       121, 122, 463, 464, 271, 273, 116, 117, 118, 494, 495, 496, 497, 498, 499, 500,
#       119, 120, 772, 773, 960]
# ie = [364, 365]                   # RTÉ One, RTÉ2 (RTÉ's own feeds are DRM-locked)
