providers_file = "./config/providers.toml"

[server]
bind = "0.0.0.0:8080"
public_url = "http://localhost:8080"
# web_dist = "/srv/iris/web"  # path to React build output (set in production)

[storage]
data_dir = "./data"
download_dir = "./data/downloads"
max_storage_gb = 500
cleanup_threshold_pct = 90
cleanup_target_pct = 75
# BitTorrent listen port (TCP + UDP). Pin so you can forward it in your
# router/firewall.
torrent_port = 45100

[auth]
# Override every value below with IRIS_AUTH__<KEY> environment variables in
# production. The JWT secret in particular MUST come from the environment.
jwt_secret = "change-me-in-production"
access_ttl_secs = 3600
refresh_ttl_secs = 604800
invitation_ttl_secs = 604800

# The bootstrap admin user — created on first boot if the users table is
# empty. Prefer setting these via env (IRIS_AUTH__BOOTSTRAP_ADMIN__EMAIL /
# IRIS_AUTH__BOOTSTRAP_ADMIN__PASSWORD) so credentials don't live in a file
# you might commit. The block below is left commented out as a reminder.
#
# [auth.bootstrap_admin]
# email = "admin@iris.local"
# password = "change-me-immediately"
