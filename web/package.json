{
  "name": "web",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-vendor": "bun scripts/sync-vendor.mjs",
    "sync-vendor:check": "bun scripts/sync-vendor.mjs --check",
    "predev": "bun run sync-vendor && bun run gen-types",
    "prebuild": "bun run sync-vendor && bun run gen-types",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen-types": "openapi-typescript openapi.json -o src/lib/api-types.ts",
    "gen-api": "cargo run -q -p iris-api --bin gen-openapi -- --write && bun run gen-types",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/cal-sans": "5.2.3",
    "@hevcjs/core": "^1.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@jellyfin/libass-wasm": "^4.2.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-virtual": "3.14.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "hls.js": "^1.6.16",
    "libav.js": "^6.8.8",
    "libavjs-webcodecs-bridge": "^0.3.2",
    "libpgs": "^0.8.1",
    "lucide-react": "^1.20.0",
    "mediabunny": "^1.48.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@webgpu/types": "^0.1.70",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "patchedDependencies": {
    "mediabunny@1.48.1": "patches/mediabunny@1.48.1.patch"
  }
}
