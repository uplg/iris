{
  "name": "web",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-vendor": "bun ../packages/iris-core/sync-vendor.mjs --out public",
    "sync-vendor:check": "bun ../packages/iris-core/sync-vendor.mjs --out public --check",
    "predev": "bun run sync-vendor && bun run gen-types",
    "prebuild": "bun run sync-vendor && bun run gen-types",
    "build": "tsc -b && vite build",
    "lint": "cd .. && web/node_modules/.bin/oxlint -c web/.oxlintrc.json web packages",
    "lint:fix": "cd .. && web/node_modules/.bin/oxlint -c web/.oxlintrc.json --fix web packages",
    "format": "cd .. && web/node_modules/.bin/oxfmt -c web/.oxfmtrc.json web packages",
    "format:check": "cd .. && web/node_modules/.bin/oxfmt -c web/.oxfmtrc.json --check web packages",
    "gen-types": "bun install --cwd tools/api-gen && bun run --cwd tools/api-gen gen",
    "gen-api": "cargo run -q -p iris-api --bin gen-openapi -- --write && bun run gen-types",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/cal-sans": "^5.3.0",
    "@iris/api": "workspace:*",
    "@iris/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
