{
  "name": "web",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-vendor": "bun scripts/sync-vendor.mjs",
    "sync-vendor:check": "bun scripts/sync-vendor.mjs --check",
    "predev": "bun run sync-vendor && bun run gen-types",
    "prebuild": "bun run sync-vendor && bun run gen-types",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen-types": "bun install --cwd tools/api-gen && bun run --cwd tools/api-gen gen",
    "gen-api": "cargo run -q -p iris-api --bin gen-openapi -- --write && bun run gen-types",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/cal-sans": "5.2.3",
    "@hevcjs/core": "^1.3.1",
    "@hookform/resolvers": "^5.4.0",
    "@jellyfin/libass-wasm": "^4.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "hls.js": "^1.6.16",
    "libav.js": "^6.9.8",
    "libavjs-webcodecs-bridge": "^0.3.2",
    "libpgs": "^0.8.1",
    "lucide-react": "^1.24.0",
    "mediabunny": "^1.50.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "oxfmt": "0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4"
  },
  "patchedDependencies": {
    "mediabunny@1.50.8": "patches/mediabunny@1.50.8.patch"
  }
}
