# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Vendored static assets — regenerated from node_modules by `bun run sync-vendor`
# (predev/prebuild). Never committed, so a committed copy can't drift from the
# installed package version. See scripts/sync-vendor.mjs.
public/libass/
public/hevcjs/
public/libpgs/
public/libavjs/

# Generated TS API types — regenerated from the committed openapi.json by
# `bun run gen-types` (predev/prebuild). bun-only, so the Docker web-builder
# (no Rust toolchain) produces them too; never committed → can't drift from
# the spec. NB: web/openapi.json itself IS committed (it's the contract, kept
# in sync with the Rust types by the iris-api snapshot test).
src/lib/api-types.ts

