+// Iris patch: down-convert a dav1d high-bit-depth (10/12-bit) plane to the
+// 8-bit YV12 ANativeWindow buffer. HBD planes hold one little-endian 16-bit
+// sample per pixel; we shift the top 8 bits out (>> (bpc - 8)) so the source
+// stays a normal 8-bit YUV plane. `source_stride` is in bytes; `width` is in
+// samples. SDR content only loses sub-perceptual precision; the alternative
+// is no playback at all (the stock wrapper errors on any HBD frame).
+void CopyPlaneDownscaleToByte(const uint8_t* source, int source_stride,
+                              uint8_t* destination, int destination_stride,
+                              int width, int height, int bpc) {
+  const int shift = bpc - 8;
+  while (height--) {
+    const uint16_t* source16 = reinterpret_cast<const uint16_t*>(source);
+    for (int x = 0; x < width; x++) {
+      destination[x] = static_cast<uint8_t>(source16[x] >> shift);
+    }
+    source += source_stride;
+    destination += destination_stride;
+  }
+}
