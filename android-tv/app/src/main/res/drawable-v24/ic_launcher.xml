<?xml version="1.0" encoding="utf-8"?>
<!-- App icon (API 24+): the smooth-gradient Iris diamond, matched 1:1 to the
     web favicon (web/public/favicon.svg) for cross-platform consistency —
     slate ground, soft violet glow, indigo→violet→fuchsia gradient diamond,
     upper facet highlight. aapt `offset` gradients need API 24, hence the
     `-v24` qualifier; `drawable/ic_launcher.xml` is the flat faceted fallback
     for API 23. Diamond kept within the adaptive-icon safe zone (~66 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground -->
    <path
        android:fillColor="#0B0C10"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Soft brand glow, upper-right (mirrors the favicon's glow) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="79"
                android:centerY="27"
                android:gradientRadius="80">
                <item android:offset="0" android:color="#33A58DFF" />
                <item android:offset="1" android:color="#00A58DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diamond -->
    <path android:pathData="M54,24 L84,54 L54,84 L24,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="78">
                <item android:offset="0" android:color="#FFF08FE8" />
                <item android:offset="0.5" android:color="#FFA58DFF" />
                <item android:offset="1" android:color="#FF69C1FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper facet highlight (gem shading) -->
    <path
        android:fillColor="#1FFFFFFF"
        android:pathData="M54,24 L84,54 L24,54 Z" />

</vector>
