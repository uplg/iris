<?xml version="1.0" encoding="utf-8"?>
<!-- Iris is self-hosted: a household may run its server over plain HTTP on its
     LAN (http://192.168.x.y:8080). Android can't scope cleartext to an IP
     range — a <domain> entry is a host name, so "192.168.0.0/16" matched
     nothing and every LAN server was unreachable — hence cleartext is allowed
     for the server address the user types. The public deployment and the
     update download (synthe.se) are HTTPS anyway. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
