<?xml version="1.0" encoding="utf-8"?>
<!-- Backdrop of the player overlay: a light overall dim so the picture stays
     legible, and two shadows that carry the title (top) and the transport
     controls (bottom). Sized in dp on purpose — the shadows must not scale
     with the panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#2E000000"/>
    </shape>
  </item>
  <item android:gravity="top" android:height="220dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="270"
          android:startColor="#B8000000"
          android:centerColor="#40000000"
          android:endColor="#00000000"/>
    </shape>
  </item>
  <item android:gravity="bottom" android:height="320dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="90"
          android:startColor="#D6000000"
          android:centerColor="#5A000000"
          android:endColor="#00000000"/>
    </shape>
  </item>
</layer-list>
