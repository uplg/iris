<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner. Hybrid, fully driven from XML: the smooth
     vector gradient ground (banner_bg) with the real Cal Sans "Iris /"
     wordmark layered on top as a transparent bitmap. A VectorDrawable can't
     embed a font, so the wordmark is rasterised from res/font by
     scripts/gen_banner.py (run it to regenerate / add densities). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/banner_bg" />
    <item android:drawable="@drawable/banner_wordmark" />
</layer-list>
