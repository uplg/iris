<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: the unified Iris diamond, shared with the web favicon
     (web/public/favicon.svg). The brand ramp is faceted with FLAT fills
     (top-left fuchsia → center violet → bottom-right blue) rather than an
     aapt gradient — `offset` gradients need API 24 and minSdk is 23, so flat
     facets keep it valid + previewable on every target. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground -->
    <path
        android:fillColor="#0B0C10"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Diamond, four facets meeting at the center (54,54). Points:
         top (54,24), right (84,54), bottom (54,84), left (24,54). -->
    <!-- top-left -->
    <path
        android:fillColor="#F08FE8"
        android:pathData="M54,54 L54,24 L24,54 Z" />
    <!-- top-right -->
    <path
        android:fillColor="#A58DFF"
        android:pathData="M54,54 L54,24 L84,54 Z" />
    <!-- bottom-left -->
    <path
        android:fillColor="#9E8BFA"
        android:pathData="M54,54 L24,54 L54,84 Z" />
    <!-- bottom-right -->
    <path
        android:fillColor="#69C1FC"
        android:pathData="M54,54 L84,54 L54,84 Z" />

</vector>
