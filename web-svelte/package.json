{
	"name": "web-svelte",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"sync-vendor": "bun ../packages/iris-core/sync-vendor.mjs --out static",
		"gen-types": "bun install --cwd ../web/tools/api-gen && bun run --cwd ../web/tools/api-gen gen",
		"dev": "bun run sync-vendor && bun run gen-types && vite dev",
		"build": "bun run sync-vendor && bun run gen-types && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"lint": "cd .. && web-svelte/node_modules/.bin/oxlint -c web-svelte/.oxlintrc.json --deny-warnings web-svelte",
		"format": "cd .. && web-svelte/node_modules/.bin/oxfmt -c web-svelte/.oxfmtrc.json web-svelte",
		"format:check": "cd .. && web-svelte/node_modules/.bin/oxfmt -c web-svelte/.oxfmtrc.json --check web-svelte",
		"check": "bun run gen-types && bun scripts/css.check.ts && bun run format:check && bun run lint && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@iris/api": "workspace:*",
		"@iris/core": "workspace:*"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tanstack/svelte-query": "6.3.1",
		"@types/node": "26.6.4",
		"@vitest/browser-playwright": "5.0.3",
		"axe-core": "4.14.0",
		"bits-ui": "2.19.5",
		"dompurify": "3.4.16",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"playwright": "1.63.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "3.1.0"
	}
}
